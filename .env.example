# 复制为 .env，填写密钥；不要提交 .env。非密钥设置也可以写进 config.json（见 config.example.json），这里的优先。

# ---- 服务器 ----
# MC_HOST=127.0.0.1
# MC_PORT=25565
# MC_NAME=MinecraftBot
# MC_VERSION=            # 留空 = 自动检测（推荐）
# MC_PREFIX=cb,小助手     # 额外的唤醒词，bot 一直有效

# ---- AI（选一个后端；都不填就只认固定指令）----
# AI_PROVIDER=deepseek   # deepseek / openai（任何 OpenAI 兼容接口）/ anthropic / external（交给外部 agent）/ off
DEEPSEEK_API_KEY=
# AI_API_KEY=            # 通用密钥，优先于下面三个
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   # openai 后端的地址；本机 Ollama: http://127.0.0.1:11434/v1
# AI_MODEL=
# AI_JSON_MODE=off       # 接口不支持 response_format 时关掉
# AI_RPM=6               # 每分钟最多请求数（1-60）
# AI_RPH=120             # 每小时最多请求数（1-2000）

# ---- 本机 Agent API / MCP（两个都设才开）----
# MC_AGENT_PORT=25599
# MC_AGENT_TOKEN=        # 至少 24 位：openssl rand -hex 24

# ---- 模组扩展和工作流 ----
# MC_MODS=               # 需手动启用的扩展 ID，多个用逗号分隔；按目标服务器规则填写
# MC_MODS_DISABLE=
# MC_WORKFLOWS_AUTO=off  # 关掉工作流自动触发

# ---- 本地自主日程（默认关闭，只在允许附近采集的环境启用）----
# MC_AUTONOMY=off
# MC_AUTONOMY_TICK=5000  # 检查间隔，毫秒
# MC_AUTONOMY_MAX=60     # 每小时动作数；没有方块数/资源消耗预算

# ---- 上线打招呼特效（标准 RCON；不配就用 /msg）----
# MC_SERVER_NAME=我的服务器
# MC_RCON_PASSWORD=
# MC_RCON_HOST=127.0.0.1
# MC_RCON_PORT=25575

# Long-term memory: choose a stable world ID; rotate it when the server world resets.
# With no world ID, new automatic facts are disabled (legacy notes/places remain).
MC_MEMORY_WORLD=
MC_MEMORY_OBSERVE=on
