{
  "name": "mc-bot",
  "version": "1.9.0",
  "description": "Minecraft cooperative survival bot for vanilla, Paper, Fabric, Forge and NeoForge servers, with pluggable AI backends, workflows, mod extensions and an MCP bridge",
  "main": "bot.js",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --max-old-space-size=256 --require ./log-time.js bot.js",
    "check": "node scripts/check.js",
    "probe:registry": "node scripts/probe-registry.js",
    "test": "node --test test/*.test.js",
    "mcp": "node scripts/mcp-server.js",
    "lab:versions": "node scripts/lab/version-matrix.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "minecrafthawkeye": "^1.3.9",
    "mineflayer": "^4.39.0",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-pvp": "^1.3.2",
    "mineflayer-tool": "^1.2.0"
  }
}
